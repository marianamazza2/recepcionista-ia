# Copiá este archivo a .env (que git ignora) y completá los valores.
# Nunca subas contraseñas ni claves al repo.

# Base contra la que corren los tests (npm test, npm run test:sql).
# Local: el Postgres 17 de Homebrew.
DATABASE_URL=postgresql://USUARIO@127.0.0.1:5432/recepcionista_dev

# Proyecto Supabase en la nube (Fase 1 · 1.9). Solo hace falta para verificar
# contra Supabase: ver scripts/con-supabase.sh.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=
# Opcional: la URL del proyecto si no es https://<SUPABASE_PROJECT_REF>.supabase.co
# SUPABASE_URL=

# Panel interno (Fase 4). Las cuentas son de Supabase Auth del proyecto de
# arriba (SUPABASE_PROJECT_REF y SUPABASE_ANON_KEY). La clave de servicio
# (secreta) solo la usa `npm run panel:cuenta` para crear cuentas: nunca en
# Vercel ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Agente (Fase 2). La clave es secreta: solo en .env, nunca en el código.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo. Cambiarlos es una decisión de coste, no del código.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=low
# Límites (control de coste, maestro §9). Si se superan, el agente deriva.
AGENT_MAX_VUELTAS=8
AGENT_MAX_TOKENS_CONVERSACION=500000
# Tope de salida por llamada (incluye el pensamiento) y espera máxima por llamada.
AGENT_MAX_TOKENS_RESPUESTA=8000
AGENT_TIMEOUT_MS=60000

# Demo local del widget (Fase 3, npm run dev). Opcionales: de serie 4311 (el
# servidor del widget y la API) y 4310 (la web de Estética Aurora).
# API_PORT=4311
# DEMO_PORT=4310
# PANEL_PORT=4312

# Solo en el proyecto de Vercel (no hace falta en local): la URL pública del
# servidor del widget, sin barra final. La usa npm run build:vercel.
# PUBLIC_API_URL=https://…vercel.app
# Opcional: el dominio propio del panel (su raíz lleva a /panel/).
# PANEL_HOST=recepcionista-ia-panel.vercel.app
