{
  "name": "recepcionista-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Recepcionista IA: motor de reservas, núcleo del agente, canal widget web y panel interno (Fase 4)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "./scripts/run-sql-tests.sh",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p widget && tsc --noEmit -p admin",
    "chat": "tsx src/cli/chat.ts",
    "agent:eval": "tsx src/cli/eval.ts",
    "dev": "tsx src/dev/server.ts",
    "consumo": "tsx src/cli/consumo.ts",
    "build:widget": "tsx src/cli/build-widget.ts",
    "build:vercel": "tsx src/vercel/build.ts",
    "panel:cuenta": "tsx src/cli/panel-cuenta.ts",
    "build:panel": "vite build --config admin/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
